using Gtk 4.0;
using Adw 1;

template $GcalScheduleSection: $GcalEventEditorSection {
  Adw.InlineViewSwitcher {
    stack: schedule_type_stack;
    homogeneous: true;
    sensitive: bind template.dialog as <$GcalEventEditorDialog>.writable;
  }

  Adw.ViewStack schedule_type_stack {
    margin-top: 12;
    vhomogeneous: false;

    Adw.ViewStackPage {
      title: _("_All Day");
      name: "all-day";
      use-underline: true;

      child: Adw.PreferencesGroup {
        separate-rows: true;

        $GcalDateChooserRow start_date_row {
          title: _("Start Date");
          notify::date => $on_start_date_changed_cb(template) not-swapped;
          editable: bind template.dialog as <$GcalEventEditorDialog>.writable;
        }

        $GcalDateChooserRow end_date_row {
          title: _("End Date");
          notify::date => $on_end_date_changed_cb(template) not-swapped;
          editable: bind template.dialog as <$GcalEventEditorDialog>.writable;
        }
      };
    }

    Adw.ViewStackPage {
      title: _("_Time Slot");
      name: "time-slot";
      use-underline: true;

      child: Box {
        orientation: vertical;
        spacing: 12;

        $GcalDateTimeChooser start_date_time_chooser {
          date-label: _("Start Date");
          time-label: _("Start Time");
          notify::date-time => $on_start_date_time_changed_cb(template) not-swapped;
          editable: bind template.dialog as <$GcalEventEditorDialog>.writable;
        }

        $GcalDateTimeChooser end_date_time_chooser {
          date-label: _("End Date");
          time-label: _("End Time");
          notify::date-time => $on_end_date_time_changed_cb(template) not-swapped;
          editable: bind template.dialog as <$GcalEventEditorDialog>.writable;
        }
      };
    }
  }

  Adw.PreferencesGroup {
    margin-top: 12;
    sensitive: bind template.dialog as <$GcalEventEditorDialog>.writable;

    Adw.ComboRow repeat_combo {
      title: _("Repeat");
      valign: center;

      model: StringList {
        strings [
          _("No Repeat"),
          _("Daily"),
          _("Monday – Friday"),
          _("Weekly"),
          _("Monthly"),
          _("Yearly"),
          _("Imported recurrence"),
        ]
      };

      notify::selected-item => $on_repeat_type_changed_cb();
    }

    Adw.ActionRow repeat_interval_row {
      visible: false;
      title: _("Repeat Every");
      activatable-widget: repeat_interval_spin;

      Box {
        spacing: 6;
        valign: center;

        SpinButton repeat_interval_spin {
          numeric: true;
          width-chars: 5;
          adjustment: repeat_interval_adjustment;
          value-changed => $on_repeat_interval_changed_cb() swapped;
        }

        Label repeat_interval_unit_label {
          xalign: 0;
        }
      }
    }

    Adw.ActionRow weekday_row {
      visible: false;
      title: _("Repeat On");

      Box {
        spacing: 3;
        valign: center;

        ToggleButton monday_button {
          label: _("Mon");
          tooltip-text: _("Monday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton tuesday_button {
          label: _("Tue");
          tooltip-text: _("Tuesday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton wednesday_button {
          label: _("Wed");
          tooltip-text: _("Wednesday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton thursday_button {
          label: _("Thu");
          tooltip-text: _("Thursday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton friday_button {
          label: _("Fri");
          tooltip-text: _("Friday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton saturday_button {
          label: _("Sat");
          tooltip-text: _("Saturday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }

        ToggleButton sunday_button {
          label: _("Sun");
          tooltip-text: _("Sunday");
          toggled => $on_weekday_toggled_cb(template) not-swapped;
        }
      }
    }

    Adw.ComboRow monthly_pattern_combo {
      visible: false;
      title: _("Monthly Pattern");

      model: StringList {
        strings [
          _("Day of the month"),
          _("Weekday position"),
        ]
      };

      notify::selected-item => $on_monthly_pattern_changed_cb();
    }

    Adw.ActionRow imported_recurrence_row {
      visible: false;
      title: _("Imported recurrence");
      subtitle: _("This rule is more complex than the editor supports and will be preserved unless replaced");
      icon-name: "dialog-information-symbolic";
    }

    Adw.ComboRow repeat_duration_combo {
      title: _("End Repeat");
      valign: center;

      model: StringList {
        strings [
          _("Forever"),
          _("Number of Occurrences"),
          _("Until Date"),
        ]
      };

      notify::selected-item => $on_repeat_duration_changed_cb();
    }

    Adw.ActionRow {
      visible: bind number_of_occurrences_spin.visible;
      title: _("Number of Occurrences");
      activatable-widget: number_of_occurrences_spin;

      SpinButton number_of_occurrences_spin {
        visible: false;
        numeric: true;
        adjustment: number_of_occurrences_adjustment;
        valign: center;
        value-changed => $on_number_of_occurrences_changed_cb() swapped;
      }
    }

    Adw.ActionRow {
      visible: bind until_date_selector.visible;
      title: _("End Repeat Date");
      activatable-widget: until_date_selector;

      $GcalDateSelector until_date_selector {
        visible: false;
        valign: center;
        notify::date => $on_until_date_changed_cb() swapped;
      }
    }
  }
}

Adjustment number_of_occurrences_adjustment {
  lower: 2;
  upper: 999999999;
  step-increment: 1;
  page-increment: 1;
  page-size: 10;
  value: 2;
}

Adjustment repeat_interval_adjustment {
  lower: 1;
  upper: 32767;
  step-increment: 1;
  page-increment: 10;
  value: 1;
}
